"data/events_engi.xml.rawclobber$//event[@name=\"EVENT_ENGI_GIVE_MAX_HULL\"]/text"
msgstr ""

#: src-ru/data/events_engi.xml.rawclobber:282
msgid ""
"data/events_engi.xml.rawclobber$//event[@name=\"EVENT_ENGI_GIVE_MAX_HULL\"]/choice[1]/text"
msgstr ""

