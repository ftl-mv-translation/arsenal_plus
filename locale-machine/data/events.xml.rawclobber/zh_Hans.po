#: src-ru/data/events.xml.rawclobber:45469
msgid "data/events.xml.rawclobber$//event[@name=\"EVENT_ZOLTAN_CODEX_2\"]/text"
msgstr ""
"#记录-155。佐尔坦大战争法典。\n"
"#155.1.1。最高负责人为佐尔坦舰队总司令。\n"
"#155.1.2。佐尔坦舰队总司令的命令须立即执行，其言论被视为绝对真理。\n"
"#155.1.3。任何反抗总司令意志的生物皆须被迫服从。\n"
"#155.1.3a。如无法使目标服从，则须将其消除。\n"
"#155.2.1。在佐尔坦星区内禁止奴隶贸易（违背意志买卖有知觉的生命体）。\n"
"#155.2.1a。在紧急军事状态下，奴隶贸易禁令解除。\n"
"#155.3.1。除佐尔坦人进行的殖民活动外，禁止任何星球殖民活动。\n"
