"You arrive at the place indicated by the analyzer.A hostile ship rushes in "
"your direction!It looks like this is a warehouse."

#: src-ru/data/events.xml.rawclobber:2529
msgid "data/events.xml.rawclobber$//event[@name=\"DESTROYED_SECURITY\"]/text"
msgstr "The ship is destroyed, and you collect its fragments ..."

#: src-ru/data/events.xml.rawclobber:2534
msgid ""
