#: src-ru/data/events_pirate.xml.rawclobber:168
msgid ""
"data/events_pirate.xml.rawclobber$//textList[@name=\"START_BEACON_PIRATE\"]/text[11]"
msgstr ""
"The robbery captured this sector.Here you are unlikely to fly towards a "
